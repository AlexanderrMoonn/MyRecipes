# Example systemd unit to keep Family Recipes running and start it on boot.
#
# 1. Copy the whole recipe-site folder onto your server, e.g. to
#    /opt/family-recipes (adjust the paths below if you put it elsewhere).
# 2. Run `npm install --omit=dev` inside that folder once.
# 3. Copy this file to /etc/systemd/system/family-recipes.service
#    (drop the .example suffix)
# 4. sudo systemctl daemon-reload
# 5. sudo systemctl enable --now family-recipes
# 6. Check status/logs: sudo systemctl status family-recipes
#                        sudo journalctl -u family-recipes -f

[Unit]
Description=Family Recipes - self-hosted recipe site
After=network.target

[Service]
Type=simple
# Change this to wherever you place the app folder:
WorkingDirectory=/opt/family-recipes
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
Environment=PORT=3000
Environment=NODE_ENV=production

# Run as a dedicated, unprivileged user if you can (recommended):
# User=recipebox
# Group=recipebox

[Install]
WantedBy=multi-user.target
